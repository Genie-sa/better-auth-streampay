{
  "name": "better-auth-streampay",
  "version": "2.2.0",
  "description": "Community Better Auth plugin for StreamPay with consumers, checkout, portal, subscriptions, and signed webhooks. Not affiliated with Stream.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "streampay",
    "stream-pay",
    "payments",
    "payment-gateway",
    "subscriptions",
    "recurring-payments",
    "checkout",
    "billing",
    "webhooks",
    "typescript",
    "saudi-arabia",
    "saudi-payments",
    "fintech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genie-sa/better-auth-streampay.git"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run check",
    "dev": "tsup --watch",
    "test": "vitest run --exclude tests/live/**/*.test.ts",
    "test:live": "STREAMPAY_LIVE=1 vitest run tests/live",
    "test:live:write": "STREAMPAY_LIVE=1 STREAMPAY_LIVE_WRITE=1 vitest run tests/live",
    "test:watch": "vitest --exclude tests/live/**/*.test.ts",
    "test:coverage": "vitest run --coverage --exclude tests/live/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "lefthook install"
  },
  "peerDependencies": {
    "@streamsdk/typescript": "^1.1.3",
    "better-auth": "^1.6.17",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@changesets/cli": "^2.31.0",
    "@streamsdk/typescript": "^1.1.3",
    "@types/node": "^25.6.0",
    "better-auth": "^1.6.17",
    "lefthook": "^2.1.6",
    "msw": "^2.13.3",
    "pkg-pr-new": "^0.0.66",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "zod": "^4.4.3"
  }
}
