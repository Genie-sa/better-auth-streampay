{
  "name": "better-auth-streampay",
  "version": "0.2.0",
  "description": "Community Better Auth plugin for StreamPay — consumers, checkout, portal, subscriptions, and signed webhooks. Not affiliated with Stream.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "better-auth",
    "better-auth-plugin",
    "streampay",
    "stream-pay",
    "payments",
    "subscriptions",
    "saudi-arabia",
    "fintech"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/y0u-0/better-auth-streampay"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build && bun run typecheck",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ./src ./tests",
    "format": "biome format --write ./src ./tests"
  },
  "peerDependencies": {
    "@streamsdk/typescript": "^1.0.6",
    "better-auth": "^1.4.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@streamsdk/typescript": "^1.0.6",
    "@types/node": "^25.6.0",
    "better-auth": "^1.6.5",
    "msw": "^2.13.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "zod": "^4.3.6"
  }
}
